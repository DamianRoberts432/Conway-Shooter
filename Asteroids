app = Flask(__name__)
connected_clients = set()

# High-density coordinate arena grid space footprint
GRID_SIZE = 128
EMPTY = 0

# Core game state managed strictly as a flat hashing dictionary of coordinate pairs
grid_cells = {}

teams_config = {
    "1": {"color": "#ff3333", "name": "RED", "tag": "R"},
    "2": {"color": "#00aaff", "name": "BLUE", "tag": "B"},
    "3": {"color": "#33cc33", "name": "GREEN", "tag": "G"},
    "4": {"color": "#e6b800", "name": "YELLOW", "tag": "Y"},
    "5": {"color": "#ff00ff", "name": "MAGENTA", "tag": "M"},
    "6": {"color": "#00ffff", "name": "CYAN", "tag": "C"}
}

players = {}
lasers = []      # Active projectile objects: [{"x", "y", "vx", "vy", "team"}]
explosions = []  # Particle decay caches: [{"x", "y", "rad", "alpha", "color"}]

# Core Citadel properties sitting at the absolute center
core_x = 64
core_y = 64
core_shield = 100

def seed_outer_space_cells():
    global grid_cells
    # Spawn initial deep-space swarms around the outer borders of the 128x128 map
    for _ in range(300):
        side = random.randint(0, 3)
        if side == 0:   # Top Ring Boundary
            rx, ry = random.randint(0, GRID_SIZE-1), random.randint(0, 15)
        elif side == 1: # Bottom Ring Boundary
            rx, ry = random.randint(0, GRID_SIZE-1), random.randint(GRID_SIZE-16, GRID_SIZE-1)
        elif side == 2: # Left Ring Boundary
            rx, ry = random.randint(0, 15), random.randint(0, GRID_SIZE-1)
        else:           # Right Ring Boundary
            rx, ry = random.randint(GRID_SIZE-16, GRID_SIZE-1), random.randint(0, GRID_SIZE-1)
        
        grid_cells[(rx, ry)] = random.randint(1, 6)

seed_outer_space_cells()

