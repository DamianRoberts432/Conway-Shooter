import asyncio
import glob
import json
import math
import random
import socket
import sys
import threading

import serial
import websockets
from flask import Flask, Response

app = Flask(__name__)
connected_clients = set()

GRID_SIZE = 128
EMPTY = 0
CENTER_X = 64
CENTER_Y = 64
INITIAL_CORE_SHIELD = 100

grid_cells = {}
players = {}
lasers = []
explosions = []
core_shield = INITIAL_CORE_SHIELD

teams_config = {
    "1": {"color": "#ff3333", "name": "RED", "tag": "R"},
    "2": {"color": "#00aaff", "name": "BLUE", "tag": "B"},
    "3": {"color": "#33cc33", "name": "GREEN", "tag": "G"},
    "4": {"color": "#e6b800", "name": "YELLOW", "tag": "Y"},
    "5": {"color": "#ff00ff", "name": "MAGENTA", "tag": "M"},
    "6": {"color": "#00ffff", "name": "CYAN", "tag": "C"},
}


def reset_game_state():
    global grid_cells, players, lasers, explosions, core_shield
    grid_cells = {}
    players = {}
    lasers = []
    explosions = []
    core_shield = INITIAL_CORE_SHIELD
    seed_outer_space_cells()


def seed_outer_space_cells():
    global grid_cells
    grid_cells.clear()

    for _ in range(300):
        side = random.randint(0, 3)
        if side == 0:
            x, y = random.randint(0, GRID_SIZE - 1), random.randint(0, 15)
        elif side == 1:
            x, y = random.randint(0, GRID_SIZE - 1), random.randint(GRID_SIZE - 16, GRID_SIZE - 1)
        elif side == 2:
            x, y = random.randint(0, 15), random.randint(0, GRID_SIZE - 1)
        else:
            x, y = random.randint(GRID_SIZE - 16, GRID_SIZE - 1), random.randint(0, GRID_SIZE - 1)

        grid_cells[(x, y)] = random.randint(1, 6)


reset_game_state()


