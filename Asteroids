GRID_SIZE = 128
EMPTY = 0
CENTER_X = 64
CENTER_Y = 64
INITIAL_CORE_SHIELD = 100

grid_cells = {}
players = {}
lasers = []
explosions = []
core_shield = INITIAL_CORE_SHIELD

teams_config = {
    "1": {"color": "#ff3333", "name": "RED", "tag": "R"},
    "2": {"color": "#00aaff", "name": "BLUE", "tag": "B"},
    "3": {"color": "#33cc33", "name": "GREEN", "tag": "G"},
    "4": {"color": "#e6b800", "name": "YELLOW", "tag": "Y"},
    "5": {"color": "#ff00ff", "name": "MAGENTA", "tag": "M"},
    "6": {"color": "#00ffff", "name": "CYAN", "tag": "C"},
}


def reset_game_state():
    global grid_cells, players, lasers, explosions, core_shield
    grid_cells = {}
    players = {}
    lasers = []
    explosions = []
    core_shield = INITIAL_CORE_SHIELD
    seed_outer_space_cells()


def seed_outer_space_cells():
    """
    Spawn Conway patterns (not noise) near borders so automata visibly advance inward.
    """
    global grid_cells
    grid_cells.clear()

    gliders = [
        [(0, 0), (1, 0), (2, 0), (2, 1), (1, 2)],
        [(0, 1), (1, 2), (2, 0), (2, 1), (2, 2)],
        [(0, 2), (1, 0), (1, 2), (2, 1), (2, 2)],
        [(0, 0), (0, 1), (1, 1), (1, 2), (2, 1)],
    ]

    def place_pattern(px, py, team, pattern):
        for dx, dy in pattern:
            x, y = px + dx, py + dy
            if 0 <= x < GRID_SIZE and 0 <= y < GRID_SIZE:
                grid_cells[(x, y)] = team

    for _ in range(80):
        side = random.randint(0, 3)
        team = random.randint(1, 6)
        pat = random.choice(gliders)

        if side == 0:
            px, py = random.randint(0, GRID_SIZE - 4), random.randint(0, 6)
        elif side == 1:
            px, py = random.randint(0, GRID_SIZE - 4), random.randint(GRID_SIZE - 7, GRID_SIZE - 4)
        elif side == 2:
            px, py = random.randint(0, 6), random.randint(0, GRID_SIZE - 4)
        else:
            px, py = random.randint(GRID_SIZE - 7, GRID_SIZE - 4), random.randint(0, GRID_SIZE - 4)

        place_pattern(px, py, team, pat)

    for _ in range(30):
        side = random.randint(0, 3)
        team = random.randint(1, 6)
        if side == 0:
            x, y = random.randint(0, GRID_SIZE - 2), random.randint(0, 8)
        elif side == 1:
            x, y = random.randint(0, GRID_SIZE - 2), random.randint(GRID_SIZE - 10, GRID_SIZE - 2)
        elif side == 2:
            x, y = random.randint(0, 8), random.randint(0, GRID_SIZE - 2)
        else:
            x, y = random.randint(GRID_SIZE - 10, GRID_SIZE - 2), random.randint(0, GRID_SIZE - 2)

        for dx, dy in [(0, 0), (1, 0), (0, 1), (1, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < GRID_SIZE and 0 <= ny < GRID_SIZE:
                grid_cells[(nx, ny)] = team


reset_game_state()


